rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Friendships — one doc per pair, id = the two uids sorted and joined by "_".
    // The whole flow is client-side (no Cloud Functions): the requester CREATEs a
    // pending doc that already lists both members, and the recipient (anyone in
    // `members` who is NOT the requester) flips it to `accepted`. Either member can
    // read or delete it. Members can never be changed after creation.
    match /friendships/{pairId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.members.size() == 2;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && request.auth.uid != resource.data.requestedBy
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.members == resource.data.members
                    && request.resource.data.requestedBy == resource.data.requestedBy;
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.members;
    }
    match /flights/{flightId} {
      allow read: if true;
      allow create: if request.auth != null
                     && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /replays/{replayId} {
      allow read: if true;
      allow create: if request.auth != null
                     && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
      match /chunks/{chunkId} {
        allow read: if true;
        allow create: if request.auth != null
                       && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
